---
// Leonida Radio dock: a small radio fixed in the corner of EVERY page. It is never swapped out
// when the visitor navigates (see the inline router below), so the music keeps playing.
// No game audio is hosted: only official embeds (YouTube / Apple Music / Spotify), created after the first
// user gesture (browsers block sound before that). Stations with no official embed show a link only.
import { t } from '../i18n/index.js';
import { stations, dial, defaultStation } from '../data/radio.js';
const { lang } = Astro.props;
const R = t(lang).radio;
const list = [...stations].sort((a, b) => a.freq - b.freq);
const conf = {
  stations: list.map((s) => ({ id: s.id, name: s.name, hosts: s.hosts || '', genre: s.genre, freq: s.freq, type: s.type, embed: s.embed || '', url: s.url, channel: s.channel })),
  dial, def: defaultStation,
  i: { tapStart: R.tapStart, play: R.play, pause: R.pause, expand: R.expand, collapse: R.collapse, manual: R.manual, prev: R.prev, next: R.next, presets: R.presets, legal: R.legal, listen: R.listen, hosts: R.hosts, genre: R.genre, onAir: R.onAir, standby: R.standby, label: R.dockLabel },
};
---
<div id="rx-dock" class="rxd" data-rx-keep data-conf={JSON.stringify(conf)} role="region" aria-label={R.dockLabel}>
  <div class="rxd-panel" data-d="panel">
    <div class="rxd-frame" data-d="frame"></div>
    <div class="rxd-info" data-d="info" aria-live="polite"></div>
    <div class="rxd-dial" aria-hidden="true"><div class="rxd-track" data-d="track"></div><div class="rxd-needle" data-d="needle"></div></div>
    <div class="rxd-pres" data-d="pres" role="group" aria-label={R.presets}></div>
  </div>
  <div class="rxd-bar">
    <span class="rxd-led" data-d="led" aria-hidden="true"></span>
    <button type="button" class="rxd-b" data-d="prev" aria-label={R.prev}>&#9664;</button>
    <button type="button" class="rxd-b rxd-play" data-d="play" aria-label={R.play}>&#9654;</button>
    <button type="button" class="rxd-b" data-d="next" aria-label={R.next}>&#9654;&#9654;</button>
    <span class="rxd-txt"><b data-d="name">Leonida Radio</b><small data-d="sub"></small></span>
    <button type="button" class="rxd-b rxd-tog" data-d="tog" aria-expanded="false" aria-label={R.expand}>&#9650;</button>
  </div>
</div>

<style is:global>
body{padding-bottom:76px}
.rxd{position:fixed;right:12px;bottom:12px;z-index:60;width:min(380px,calc(100vw - 16px));font:.9rem/1.3 var(--body);color:var(--text)}
@media (max-width:480px){.rxd{right:8px;bottom:8px}}
.rxd-bar{display:flex;align-items:center;gap:6px;background:linear-gradient(160deg,#2a1647,#170a2a);border:2px solid var(--purple);border-radius:16px;padding:6px 8px;box-shadow:0 0 22px rgba(138,77,255,.45),0 6px 18px rgba(0,0,0,.5)}
.rxd-led{width:10px;height:10px;border-radius:50%;background:#5c2a3a;flex:none;box-shadow:0 0 0 2px #12081f}
.rxd.live .rxd-led{background:var(--bad);box-shadow:0 0 9px var(--bad),0 0 0 2px #12081f}
.rxd-b{width:38px;height:38px;flex:none;border-radius:50%;border:2px solid var(--line);background:#1e1033;color:var(--text);cursor:pointer;font-size:.8rem;line-height:1;padding:0}
.rxd-b:hover,.rxd-b:focus-visible{border-color:var(--teal)}
.rxd-play{width:44px;height:44px;background:var(--pink);color:#12081f;border-color:var(--pink);font-size:1rem}
.rxd.hint .rxd-play{animation:rxd-pulse 1.2s ease-in-out infinite}
@keyframes rxd-pulse{0%,100%{box-shadow:0 0 0 0 rgba(255,79,163,.7)}50%{box-shadow:0 0 0 10px rgba(255,79,163,0),0 0 22px rgba(255,79,163,.9)}}
.rxd-txt{display:flex;flex-direction:column;min-width:0;flex:1}
.rxd-txt b{font:700 .95rem/1.2 ui-monospace,Consolas,Menlo,monospace;color:var(--ok);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rxd-txt small{color:var(--muted);font-size:.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rxd-tog{transition:transform .2s}
.rxd.open .rxd-tog{transform:rotate(180deg)}
.rxd-panel{background:linear-gradient(160deg,#2a1647,#170a2a);border:2px solid var(--purple);border-radius:16px;padding:10px;margin-bottom:8px;box-shadow:0 0 22px rgba(138,77,255,.45),0 6px 18px rgba(0,0,0,.5);max-height:calc(100vh - 110px);overflow:auto}
/* collapsed: keep the player alive off-screen (never display:none, so it keeps playing) */
.rxd:not(.open) .rxd-panel{position:fixed;left:-10000px;top:0;width:380px;visibility:visible;margin:0}
.rxd-frame iframe{display:block;width:100%;border:0;border-radius:10px;background:#000}
.rxd-frame iframe.yt{aspect-ratio:16/9;min-height:200px}
.rxd-info{display:grid;gap:4px;margin-top:8px;font-size:.82rem}
.rxd-info p{margin:0}
.rxd-info .meta{color:var(--muted)}
.rxd-info a{color:var(--teal)}
.rxd-dial{position:relative;height:26px;margin:10px 0 4px;background:#1a0d03;border:1px solid #ff9a3c80;border-radius:8px}
.rxd-track i{position:absolute;top:15px;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#2ee6d6}
.rxd-needle{position:absolute;top:2px;bottom:2px;width:2px;margin-left:-1px;background:#ff4fa3;box-shadow:0 0 6px #ff4fa3;transition:left .45s cubic-bezier(.3,.9,.3,1)}
.rxd-pres{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-top:8px}
.rxd-pres button{display:flex;align-items:center;gap:6px;text-align:left;background:#1e1033;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:6px 8px;cursor:pointer;min-height:40px;font:.78rem/1.2 var(--body)}
.rxd-pres button:hover{border-color:var(--teal)}
.rxd-pres button[aria-pressed=true]{border-color:var(--pink);box-shadow:0 0 10px rgba(255,79,163,.5)}
.rxd-pres b{flex:none;width:20px;height:20px;border-radius:50%;background:#34195a;display:grid;place-items:center;color:var(--orange);font-size:.7rem}
@media (prefers-reduced-motion:reduce){.rxd-needle{transition:none}.rxd.hint .rxd-play{animation:none;box-shadow:0 0 0 4px rgba(255,79,163,.6)}}
</style>

<script is:inline data-rx-keep>
(function () {
  if (window.__rxDock) return;
  var root = document.getElementById('rx-dock');
  if (!root) return;
  var C = JSON.parse(root.dataset.conf), S = C.stations, I = C.i, N = S.length;
  var K1 = 'leonida-radio:station', K2 = 'leonida-radio:paused';
  function d(n) { return root.querySelector('[data-d="' + n + '"]'); }
  var el = { panel: d('panel'), frame: d('frame'), info: d('info'), track: d('track'), needle: d('needle'), pres: d('pres'), led: d('led'), prev: d('prev'), play: d('play'), next: d('next'), name: d('name'), sub: d('sub'), tog: d('tog') };
  var idx = 0, playing = false, open = false, armed = false, yt = null;
  var X = C.dial;

  function ls(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) {} return null; }
  function mk(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
  function clear(n) { while (n.firstChild) n.removeChild(n.firstChild); }
  function platform(t) { return t === 'apple' ? 'Apple Music' : t === 'spotify' ? 'Spotify' : 'YouTube'; }
  function embedUrl(s) {
    if (s.type === 'apple') return 'https://embed.music.apple.com/' + s.embed;
    if (s.type === 'spotify') return 'https://open.spotify.com/embed/album/' + encodeURIComponent(s.embed) + '?theme=0';
    if (s.type === 'youtube') return 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(s.embed) + '?autoplay=1&enablejsapi=1&playsinline=1&rel=0&modestbranding=1&origin=' + encodeURIComponent(location.origin);
    return null;
  }

  var saved = ls(K1);
  for (var i = 0; i < N; i++) if (S[i].id === (saved || C.def)) idx = i;
  var wantPlay = ls(K2) !== '1';

  function cmd(fn) { if (yt && yt.contentWindow) { try { yt.contentWindow.postMessage(JSON.stringify({ event: 'command', func: fn, args: [] }), '*'); } catch (e) {} } }
  function stopFrame() { clear(el.frame); yt = null; }

  function buildFrame() {
    stopFrame();
    var s = S[idx], url = embedUrl(s);
    if (!url) return false;
    var f = document.createElement('iframe');
    f.src = url; f.title = s.name + ' (' + platform(s.type) + ')'; f.referrerPolicy = 'strict-origin-when-cross-origin';
    f.allow = s.type === 'apple' ? 'autoplay *; encrypted-media *; clipboard-write' : 'autoplay; encrypted-media; clipboard-write; picture-in-picture; fullscreen';
    if (s.type === 'apple') f.setAttribute('sandbox', 'allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation');
    if (s.type === 'youtube') { f.className = 'yt'; f.allowFullscreen = true; yt = f; } else { f.height = s.type === 'spotify' ? 152 : 175; }
    el.frame.appendChild(f);
    return true;
  }

  function renderInfo() {
    var s = S[idx]; clear(el.info);
    if (!s.type) el.info.appendChild(mk('p', '', I.legal));
    else if (s.type !== 'youtube' && playing) el.info.appendChild(mk('p', 'meta', I.manual));
    if (s.hosts) el.info.appendChild(mk('p', 'meta', I.hosts + ': ' + s.hosts));
    el.info.appendChild(mk('p', 'meta', s.channel));
    var p = mk('p'), a = mk('a', '', I.listen); a.href = s.url; a.rel = 'noopener'; a.target = '_blank'; p.appendChild(a); el.info.appendChild(p);
  }

  function ui() {
    var s = S[idx];
    root.classList.toggle('live', playing && !!s.type);
    root.classList.toggle('hint', armed && !playing);
    el.name.textContent = s.name;
    el.sub.textContent = armed && !playing ? I.tapStart : (s.freq.toFixed(1) + ' MHz · ' + (I.genre[s.genre] || ''));
    el.play.innerHTML = playing ? '&#10074;&#10074;' : '&#9654;';
    el.play.setAttribute('aria-label', playing ? I.pause : I.play);
    el.needle.style.left = ((s.freq - X.min) / (X.max - X.min) * 100) + '%';
    el.pres.querySelectorAll('button').forEach(function (b, k) { b.setAttribute('aria-pressed', k === idx ? 'true' : 'false'); });
    el.tog.setAttribute('aria-expanded', open ? 'true' : 'false');
    el.tog.setAttribute('aria-label', open ? I.collapse : I.expand);
    root.classList.toggle('open', open);
    renderInfo();
  }

  function buildStatic() {
    clear(el.track); clear(el.pres);
    S.forEach(function (s, k) {
      var dot = document.createElement('i'); dot.style.left = ((s.freq - X.min) / (X.max - X.min) * 100) + '%'; el.track.appendChild(dot);
      var b = mk('button'); b.type = 'button'; b.appendChild(mk('b', '', String(k + 1))); b.appendChild(mk('span', '', s.name));
      b.addEventListener('click', function () { select(k, true); }); el.pres.appendChild(b);
    });
    el.prev.setAttribute('aria-label', I.prev); el.next.setAttribute('aria-label', I.next);
    root.setAttribute('aria-label', I.label); el.pres.setAttribute('aria-label', I.presets);
  }

  function start() {            // must run inside a user gesture
    armed = false; ls(K2, null); playing = true;
    var ok = buildFrame();
    if (!S[idx].type) playing = false;
    if (ok && S[idx].type !== 'youtube') open = true;   // Apple/Spotify need a press on their own play button
    ui();
  }
  function pause() {
    playing = false; ls(K2, '1');
    if (yt) cmd('pauseVideo'); else stopFrame();
    ui();
  }
  function resume() {
    ls(K2, null);
    if (yt) { playing = true; cmd('playVideo'); ui(); } else start();
  }
  function select(k, fromUser) {
    idx = (k + N) % N; ls(K1, S[idx].id);
    if (playing || armed || fromUser) { start(); } else { stopFrame(); ui(); }
  }

  el.play.addEventListener('click', function () { if (armed || !playing) { if (yt && !armed) resume(); else start(); } else pause(); });
  el.prev.addEventListener('click', function () { select(idx - 1, true); });
  el.next.addEventListener('click', function () { select(idx + 1, true); });
  el.tog.addEventListener('click', function () { open = !open; ui(); });
  root.addEventListener('keydown', function (e) { if (e.key === 'Escape' && open) { open = false; ui(); el.tog.focus(); } });

  // First visit / not paused earlier: the radio "turns on" with the first gesture anywhere on the site.
  var evs = ['pointerup', 'keydown', 'touchend', 'click'];
  function onGesture(e) {
    if (root.contains(e.target)) { off(); return; }
    off();
    if (wantPlay && S[idx].type) start();
  }
  function off() { evs.forEach(function (n) { document.removeEventListener(n, onGesture, true); }); armed = armed && false; ui(); }
  buildStatic();
  if (wantPlay && S[idx].type) { armed = true; evs.forEach(function (n) { document.addEventListener(n, onGesture, true); }); }
  ui();

  // ---- keeps the radio alive while navigating: fetch + swap the page, never touch #rx-dock ----
  var LANG = /^\/(en|fr|de|it|ko|pl|pt-br|ru|zh-hans|zh-hant|es-mx|es-es)(\/|$)/;
  var cur = location.pathname + location.search;
  function sameNode(list, n) { for (var i = 0; i < list.length; i++) if (list[i].outerHTML === n.outerHTML) return true; return false; }
  function swap(doc) {
    document.title = doc.title;
    document.documentElement.lang = doc.documentElement.lang;
    document.documentElement.dir = doc.documentElement.dir || '';
    var H = document.head;
    H.querySelectorAll('meta[name=description],meta[property^="og:"],meta[name^="twitter:"],link[rel=canonical],link[rel=alternate],link[rel=icon],script[type="application/ld+json"],meta[name=robots]').forEach(function (n) { n.remove(); });
    var waits = [];
    doc.head.querySelectorAll('meta[name=description],meta[property^="og:"],meta[name^="twitter:"],link[rel=canonical],link[rel=alternate],script[type="application/ld+json"],meta[name=robots]').forEach(function (n) { H.appendChild(document.importNode(n, true)); });
    var have = H.querySelectorAll('link[rel=stylesheet],style');
    doc.head.querySelectorAll('link[rel=stylesheet],style').forEach(function (n) {
      if (sameNode(have, n)) return;
      var c = document.importNode(n, true);
      if (c.tagName === 'LINK') waits.push(new Promise(function (r) { c.onload = c.onerror = r; }));
      H.appendChild(c);
    });
    var timeout = new Promise(function (r) { setTimeout(r, 1500); });
    return Promise.race([Promise.all(waits), timeout]).then(function () {
      var B = document.body;
      Array.prototype.slice.call(B.children).forEach(function (n) { if (!n.hasAttribute('data-rx-keep')) n.remove(); });
      B.className = doc.body.className;
      var fresh = [];
      Array.prototype.slice.call(doc.body.children).forEach(function (n) {
        if (n.hasAttribute('data-rx-keep')) return;
        var c = document.importNode(n, true);
        B.insertBefore(c, root);
        fresh.push(c);
      });
      fresh.forEach(function (c) {
        var ss = c.tagName === 'SCRIPT' ? [c] : Array.prototype.slice.call(c.querySelectorAll('script'));
        ss.forEach(function (o) {
          if (o.src && o.src.indexOf('cloudflareinsights') > -1) return;
          if (o.type === 'application/ld+json') return;
          var n = document.createElement('script');
          for (var a = 0; a < o.attributes.length; a++) n.setAttribute(o.attributes[a].name, o.attributes[a].value);
          n.text = o.text;
          o.replaceWith(n);
        });
      });
      var nd = doc.getElementById('rx-dock');
      if (nd) { try { C = JSON.parse(nd.dataset.conf); I = C.i; var keep = S[idx].id; S = C.stations; for (var k = 0; k < S.length; k++) if (S[k].id === keep) idx = k; buildStatic(); ui(); } catch (e) {} }
    });
  }
  function go(href, push) {
    fetch(href, { credentials: 'same-origin' }).then(function (r) {
      var ct = r.headers.get('content-type') || '';
      if (!r.ok || ct.indexOf('text/html') < 0) throw new Error('x');
      return r.text().then(function (t) { return { t: t, url: r.url }; });
    }).then(function (o) {
      var doc = new DOMParser().parseFromString(o.t, 'text/html');
      if (!doc.getElementById('rx-dock')) throw new Error('x');
      var u = new URL(o.url);
      return swap(doc).then(function () {
        if (push) history.pushState({ rx: 1 }, '', u.pathname + u.search + u.hash);
        cur = u.pathname + u.search;
        if (u.hash && document.getElementById(u.hash.slice(1))) document.getElementById(u.hash.slice(1)).scrollIntoView();
        else window.scrollTo(0, 0);
        var m = document.getElementById('main'); if (m) { m.setAttribute('tabindex', '-1'); try { m.focus({ preventScroll: true }); } catch (e) {} }
      });
    }).catch(function () { location.href = href; });
  }
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
    var u = new URL(a.href, location.href);
    if (u.origin !== location.origin || !LANG.test(u.pathname)) return;
    if (u.pathname + u.search === cur) return;   // same page / #hash: let the browser handle it
    e.preventDefault();
    go(u.href, true);
  });
  window.addEventListener('popstate', function () {
    if (location.pathname + location.search === cur) return;
    if (!LANG.test(location.pathname)) { location.reload(); return; }
    go(location.href, false);
  });
  window.__rxDock = { go: go };
})();
</script>
