---
// Renders an AdSense unit only when ads are enabled. The AdSense script is injected only if a client id is set.
import { site } from '../data/site.js';
const { kind = 'rail' } = Astro.props;
const client = site.adsense.client;
const slot = site.adsense.slots[kind] || '';
---
{site.adsEnabled && (
  <div class={`ad-slot ad-${kind}`}>
    {client && slot && <ins class="adsbygoogle" style="display:block" data-ad-client={client} data-ad-slot={slot} data-ad-format={kind === 'rail' ? 'vertical' : 'auto'} data-full-width-responsive="true"></ins>}
    {client && slot && <script is:inline define:vars={{ client }}>
      (function(){
        var el=document.currentScript.previousElementSibling;
        if(!el||el.offsetParent===null)return; // hidden at this breakpoint: do not request an ad
        if(!document.querySelector('script[data-adsense]')){var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.dataset.adsense='1';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+encodeURIComponent(client);document.head.appendChild(s);}
        (window.adsbygoogle=window.adsbygoogle||[]).push({});
      })();
    </script>}
  </div>
)}
