---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import AdSlot from '../components/AdSlot.astro';
import RadioDock from '../components/RadioDock.astro';
import { site, adLabel, menuLabel } from '../data/site.js';
import { t, meta, completeLocales, url } from '../i18n/index.js';

// lang: locale code; path: '' for home or '/log', '/guides/xyz' ...; jsonld: array of schema objects
const { lang, path = '', title, description, jsonld = [], ogType = 'website', image = 'index', alternates, canonicalLang, robots, noAlternates } = Astro.props;
// alternates: locales that really have this page (hreflang); canonicalLang: locale whose URL is canonical
const ui = t(lang);
const isHome = path === '';
// People search for "GTA 6": search and share tags use it, page text keeps the official "GTA VI".
const searchName = (s) => String(s).replace(/GTA([ -])VI\b/g, 'GTA$16');
const fullTitle = searchName(isHome ? title : `${title} | Leonida Atlas`);
const metaDescription = searchName(description);
const abs = (l) => new URL(url(l, path), Astro.site).href;
const canonical = abs(canonicalLang || lang);
const hreflangs = noAlternates ? [] : (alternates || completeLocales);
const nav = [
  ['/news', ui.nav.news],
  ['/posts', ui.nav.posts],
  ['/log', ui.nav.log],
  ['/community', ui.nav.community],
  ['/fact-check', ui.nav.fact],
  ['/reality-check', ui.nav.reality],
  ['/daily', ui.nav.daily],
  ['/pass', ui.nav.pass],
  ['/guides', ui.nav.guides],
  ['/gallery', ui.gallery.nav],
  ['/about', ui.nav.about],
];
const ogImage = new URL(`/og/${image}.png`, Astro.site).href;
const ads = site.adsEnabled;
const cur = path.replace(/\/$/, '');
const isCurrent = (p) => cur === p || (p === '/guides' && cur.startsWith('/guides')) || (p === '/news' && cur.startsWith('/news')) || (p === '/posts' && cur.startsWith('/posts')) || (p === '/community' && cur.startsWith('/community'));
---
<!doctype html>
<html lang={meta[lang].html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonical} />
  {hreflangs.map((l) => <link rel="alternate" hreflang={meta[l].html} href={abs(l)} />)}
  {!noAlternates && <link rel="alternate" hreflang="x-default" href={abs('en')} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#12081f" />
  <!-- Google Search Console: uncomment and paste the token once the property is created.
  -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Leonida Atlas" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={meta[lang].og} />
  {completeLocales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={meta[l].og} />)}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  <meta name="google-site-verification" content="dWOdDctCkf9_eOFsOX2MzXNTyDaNCvRvy1e5fXGDG-g" />
  <meta name="google-site-verification" content="BbJNO8aNeOS4w9B93sVxaOrk73SzpEY8sJHkaf6TXgw" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {jsonld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body class={ads ? 'has-rails' : undefined}>
  <a class="skip" href="#main">{ui.skip}</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={url(lang)}><Logo />Leonida <b>Atlas</b></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mainnav" aria-label={menuLabel[lang]}><span aria-hidden="true"></span><span class="menu-txt">{menuLabel[lang]}</span></button>
      <nav class="main" id="mainnav" aria-label="Main">
        {nav.map(([p, label]) => <a href={url(lang, p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>)}
        <details class="lang">
          <summary aria-label={ui.langLabel}>{ui.langLabel}: {meta[lang].native}</summary>
          <ul>
            {completeLocales.map((l) => (
              <li><a href={url(l, path)} lang={meta[l].html} hreflang={meta[l].html} aria-current={l === lang ? 'true' : undefined}>{meta[l].native}</a></li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </header>
  <div class="page wrap">
    {ads && <aside class="ad-rail ad-left" aria-label={adLabel[lang]}><span class="ad-label">{adLabel[lang]}</span><AdSlot kind="rail" /></aside>}
    <main id="main"><slot />
      {ads && <aside class="ad-inline" aria-label={adLabel[lang]}><span class="ad-label">{adLabel[lang]}</span><AdSlot kind="inline" /></aside>}
    </main>
    {ads && <aside class="ad-rail ad-right" aria-label={adLabel[lang]}><span class="ad-label">{adLabel[lang]}</span><AdSlot kind="rail" /></aside>}
  </div>
  <footer class="site-footer">
    <div class="wrap">
      <p>{ui.footer.disclaimer}</p>
      <p><a href={url(lang, '/about')}>{ui.footer.about}</a> · <a href={url(lang, '/disclaimer')}>{ui.footer.disc}</a> · <a href={url(lang, '/privacy')}>{ui.footer.privacy}</a> · <a href={url(lang, '/terms')}>{ui.footer.terms}</a></p>
    </div>
  </footer>
  <RadioDock lang={lang} />
  <script is:inline>
    (function(){var b=document.querySelector('.menu-btn'),n=document.getElementById('mainnav');if(!b||!n)return;
    function set(o){b.setAttribute('aria-expanded',o);n.classList.toggle('open',o)}
    b.addEventListener('click',function(){set(b.getAttribute('aria-expanded')!=='true')});
    if(window.__menuEsc)document.removeEventListener('keydown',window.__menuEsc);window.__menuEsc=function(e){if(e.key==='Escape'&&b.getAttribute('aria-expanded')==='true'){set(false);b.focus()}};document.addEventListener('keydown',window.__menuEsc);})();
  </script>
<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "23eeb6fc52fc4f138b9f5eb8d5749462"}'></script>
</body>
</html>
