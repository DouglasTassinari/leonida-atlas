---
import Base from '../layouts/Base.astro';
import { facts, rumors } from '../data/facts.js';
---
<Base title="Fact Check" description="GTA VI facts confirmed against official Rockstar Games and Take-Two pages, with source, URL and date checked. Rumors are labeled.">
  <h1>Fact Check</h1>
  <p class="lead">Every item below links to an official Rockstar Games or Take-Two page and shows the date we checked it.</p>

  <h2>Confirmed facts</h2>
  {facts.map((f) => (
    <article class="panel" id={f.id}>
      <span class="tag confirmed">Confirmed</span>
      <p><strong>{f.claim}</strong></p>
      <blockquote class="meta">“{f.quote}”</blockquote>
      <p class="meta">Source: {f.source}<br />URL: <a href={f.url} rel="noopener">{f.url}</a><br />Published: <time datetime={f.published}>{f.published}</time> · Last checked: <time datetime={f.checked}>{f.checked}</time> · Status: {f.status}</p>
    </article>
  ))}

  <h2>Rumors</h2>
  <p class="meta">Anything listed here is unverified and must not be treated as fact.</p>
  {rumors.length === 0 ? (
    <p class="panel"><span class="tag rumor">Rumor</span> No rumors tracked yet.</p>
  ) : (
    rumors.map((r) => (
      <article class="panel">
        <span class="tag rumor">Unverified rumor</span>
        <p>{r.claim}</p>
        <p class="meta">Where it appeared: {r.source}{r.url && <> - <a href={r.url} rel="noopener nofollow">{r.url}</a></>} · Date seen: {r.seen}</p>
      </article>
    ))
  )}
</Base>
