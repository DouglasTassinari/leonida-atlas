---
import Base from '../../layouts/Base.astro';
import { t, staticLocales } from '../../i18n/index.js';
export const getStaticPaths = staticLocales;
const { lang } = Astro.params;
const p = t(lang).priv;
const G = t(lang).gallery;
---
<Base lang={lang} path="/privacy" title={p.title} description={p.desc}>
  <h1>{p.title}</h1>
  <p class="meta">{p.updated}</p>
  <h2>{p.h1}</h2><p>{p.p1}</p>
  <h2>{p.h2}</h2><p>{p.p2}</p>
  <h2>{p.h3}</h2><p>{p.p3}</p>
  <h2>{p.h4}</h2><p>{p.p4}</p>
  <h2>{G.privH}</h2><p>{G.privP}</p>
</Base>
