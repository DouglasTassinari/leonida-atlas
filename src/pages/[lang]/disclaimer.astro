---
import Base from '../../layouts/Base.astro';
import { t, staticLocales } from '../../i18n/index.js';
export const getStaticPaths = staticLocales;
const { lang } = Astro.params;
const p = t(lang).disc;
---
<Base lang={lang} path="/disclaimer" title={p.title} description={p.desc}>
  <h1>{p.title}</h1>
  <p>{p.p1}</p>
  <p>{p.p2}</p>
  <p>{p.p3}</p>
</Base>
