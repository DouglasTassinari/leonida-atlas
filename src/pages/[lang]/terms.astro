---
import Base from '../../layouts/Base.astro';
import { t, staticLocales } from '../../i18n/index.js';
export const getStaticPaths = staticLocales;
const { lang } = Astro.params;
const p = t(lang).terms;
const issues = 'https://github.com/DouglasTassinari/leonida-atlas/issues';
const parts = p.p4.split(issues);
---
<Base lang={lang} path="/terms" title={p.title} description={p.desc}>
  <h1>{p.title}</h1>
  <p class="meta">{p.updated}</p>
  <h2>{p.h1}</h2><p>{p.p1}</p>
  <h2>{p.h2}</h2><p>{p.p2}</p>
  <h2>{p.h3}</h2><p>{p.p3}</p>
  <h2>{p.h4}</h2>
  <p>{parts[0]}<a href={issues} rel="noopener">{issues}</a>{parts[1]}</p>
  <h2>{p.h5}</h2><p>{p.p5}</p>
</Base>
