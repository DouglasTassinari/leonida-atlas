---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { posts } from '../../../data/posts/index.js';
import { postText } from '../../../data/posts-core.js';
import { t, staticLocales, url, meta } from '../../../i18n/index.js';
export const getStaticPaths = staticLocales;
const { lang } = Astro.params;
const p = t(lang).posts;
const site = Astro.site;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: p.home, item: new URL(url(lang), site).href },
    { '@type': 'ListItem', position: 2, name: p.title, item: new URL(url(lang, '/posts'), site).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: p.title, description: p.desc, inLanguage: meta[lang].html,
    mainEntity: { '@type': 'ItemList', numberOfItems: posts.length,
      itemListElement: posts.map((x, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(url(lang, '/posts/' + x.slug), site).href, name: postText(x, lang).title })) } },
];
---
<Base lang={lang} path="/posts" title={p.title} description={p.desc} jsonld={jsonld} image="news">
  <nav class="crumbs" aria-label="Breadcrumb"><a href={url(lang)}>{p.home}</a> / {p.title}</nav>
  <h1>{p.title}</h1>
  <p class="lead">{p.lead}</p>
  {posts.length === 0 ? <p class="meta">{p.empty}</p> : (
    <ul class="ncards">{posts.map((x) => <PostCard post={x} lang={lang} />)}</ul>
  )}
</Base>
