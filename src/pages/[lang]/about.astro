---
import Base from '../../layouts/Base.astro';
import { t, staticLocales, url } from '../../i18n/index.js';
export const getStaticPaths = staticLocales;
const { lang } = Astro.params;
const p = t(lang).about;
---
<Base lang={lang} path="/about" title={p.title} description={p.desc}>
  <h1>{p.title}</h1>
  <p>{p.p1}</p>
  <h2>{p.h2}</h2>
  <p>{p.p2}</p>
  <h2>{p.h3}</h2>
  <p>{p.p3} <a href={url(lang, '/disclaimer')}>{t(lang).footer.disc}</a></p>
</Base>
