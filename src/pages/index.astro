---
// Root URL: sends visitors to the default locale. English is the x-default.
const target = new URL('/en/', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Leonida Atlas</title>
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content="0; url=/en/" />
  <script is:inline>
    (function () {
      var map = { fr: 'fr', de: 'de', it: 'it', ko: 'ko', pl: 'pl', ru: 'ru', pt: 'pt-br', es: 'es-es' };
      var l = (navigator.language || 'en').toLowerCase(), t = 'en';
      if (l.indexOf('zh') === 0) t = /hant|tw|hk|mo/.test(l) ? 'zh-hant' : 'zh-hans';
      else if (l === 'es-mx' || l.indexOf('es-419') === 0) t = 'es-mx';
      else if (map[l.split('-')[0]]) t = map[l.split('-')[0]];
      location.replace('/' + t + '/');
    })();
  </script>
</head>
<body><p><a href="/en/">Leonida Atlas</a></p></body>
</html>
